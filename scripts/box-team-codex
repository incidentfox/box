#!/usr/bin/env bash
# Root-owned, sudo-whitelisted launcher for Box Team guest turns. It accepts only
# agent arguments after `--` and builds every Bubblewrap mount itself, including
# optional private snapshots of the owner's file-backed agent logins.
set -euo pipefail

CONFIG=/etc/box-team-sandbox.conf
CODEX=/home/factory/.npm-global/lib/node_modules/@openai/codex/node_modules/@openai/codex-linux-x64/vendor/x86_64-unknown-linux-musl/bin/codex
CODEX_SANDBOX=/opt/box-tools/node-global/lib/node_modules/@openai/codex/node_modules/@openai/codex-linux-x64/vendor/x86_64-unknown-linux-musl/bin/codex
CLAUDE=/usr/lib/node_modules/@anthropic-ai/claude-code/node_modules/@anthropic-ai/claude-code-linux-x64/claude
BWRAP=/usr/bin/bwrap
[[ -r "$CONFIG" ]] && source "$CONFIG"
: "${WORKSPACE:?missing WORKSPACE in $CONFIG}"

user= workspace= cwd= runtime=codex env_stdin=false
while (($#)); do
  case "$1" in
    --runtime) runtime=${2:?}; shift 2 ;;
    --user) user=${2:?}; shift 2 ;;
    --workspace) workspace=${2:?}; shift 2 ;;
    --cwd) cwd=${2:?}; shift 2 ;;
    --env-stdin) env_stdin=true; shift ;;
    --) shift; break ;;
    *) exit 64 ;;
  esac
done
[[ $# -gt 0 && "$env_stdin" == true && "$user" =~ ^box-[a-z][a-z0-9-]{0,30}$ ]] || exit 64
id "$user" >/dev/null
id -nG "$user" | tr ' ' '\n' | grep -qx box-team
user_home=$(getent passwd "$user" | cut -d: -f6)
[[ "$user_home" == "/home/$user" && -d "$user_home" ]] || exit 69
user_group=$(id -gn "$user")
runtime_home="$user_home/.box-runtime"
install -d -m 0700 -o "$user" -g "$user_group" "$runtime_home"
root=$(realpath -e "$WORKSPACE")
[[ "$workspace" == "$root" ]] || exit 64
requested=$(realpath -m "$cwd")
[[ "$requested" == "$root" || "$requested" == "$root"/* ]] || exit 64
case "$runtime" in
  codex) runtime_host=$CODEX; runtime_bin=$CODEX_SANDBOX ;;
  claude) runtime_host=$CLAUDE; runtime_bin=$CLAUDE ;;
  *) exit 64 ;;
esac
[[ -x "$runtime_host" && -x "$BWRAP" ]] || exit 69

shared_auth=false
read -r -a shared_auth_users <<< "${SHARED_AUTH_USERS:-}"
for shared_auth_user in "${shared_auth_users[@]}"; do
  if [[ "$shared_auth_user" == "$user" ]]; then
    shared_auth=true
    break
  fi
done

auth_mount_args=()
if [[ "$shared_auth" == true ]]; then
  [[ "${SHARED_AUTH_HOME:-}" == /* ]] || exit 69
  shared_auth_home=$(realpath -e "$SHARED_AUTH_HOME")
  case "$runtime" in
    codex)
      auth_source="$shared_auth_home/.codex/auth.json"
      auth_guest_dir=/home/team/.codex
      auth_guest_file="$auth_guest_dir/auth.json"
      ;;
    claude)
      auth_source="$shared_auth_home/.claude/.credentials.json"
      auth_guest_dir=/home/team/.claude
      auth_guest_file="$auth_guest_dir/.credentials.json"
      ;;
  esac
  [[ -f "$auth_source" && -r "$auth_source" ]] || exit 69

  # The guest gets a refreshable private copy, never a writable mount of the owner's
  # credential. Root-owned parent directories prevent replacement by another process.
  auth_dir="/run/box-team-auth/$user/$runtime"
  install -d -m 0711 -o root -g root /run/box-team-auth "/run/box-team-auth/$user" "$auth_dir"
  auth_file="$auth_dir/$(basename "$auth_guest_file")"
  auth_tmp=$(mktemp "$auth_dir/.auth.XXXXXX")
  trap 'rm -f "$auth_tmp"' EXIT
  install -m 0600 -o "$user" -g "$user_group" "$auth_source" "$auth_tmp"
  mv -f "$auth_tmp" "$auth_file"
  trap - EXIT
  auth_mount_args=(--dir "$auth_guest_dir" --bind "$auth_file" "$auth_guest_file")
fi

env_dir="/run/box-team-env/$user"
install -d -m 0711 -o root -g root /run/box-team-env "$env_dir"
env_file=$(mktemp "$env_dir/.env.XXXXXX")
cleanup() { rm -f "$env_file"; }
trap cleanup EXIT
while IFS= read -r -d '' pair; do
  key=${pair%%=*}
  value=${pair#*=}
  [[ "$pair" == *=* && "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || exit 64
  if [[ "$shared_auth" == true ]]; then
    case "$runtime:$key" in
      codex:OPENAI_API_KEY|codex:CODEX_API_KEY|claude:ANTHROPIC_API_KEY|claude:CLAUDE_CODE_OAUTH_TOKEN|claude:CLAUDE_OAUTH_TOKEN)
        continue
        ;;
    esac
  fi
  printf '%s=%s\0' "$key" "$value" >> "$env_file"
done
chown "$user:$user_group" "$env_file"
chmod 0400 "$env_file"

/usr/sbin/runuser -u "$user" -- "$BWRAP" \
  --die-with-parent --new-session --unshare-all --share-net --clearenv \
  --setenv HOME /home/team --setenv PATH /opt/box-tools/node-global/bin:/usr/local/bin:/usr/bin:/bin \
  --setenv TMPDIR /tmp --setenv LANG C.UTF-8 \
  --ro-bind /usr /usr --ro-bind /bin /bin --ro-bind /lib /lib --ro-bind /lib64 /lib64 \
  --ro-bind /home/factory/.npm-global /opt/box-tools/node-global \
  --dir /etc --dir /etc/ssl --ro-bind /etc/resolv.conf /etc/resolv.conf \
  --ro-bind /etc/hosts /etc/hosts --ro-bind /etc/ssl/certs /etc/ssl/certs \
  --bind "$root" /workspace --dir /home --dir /home/team --bind "$runtime_home" /home/team --dir /run \
  --ro-bind "$env_file" /run/box-team-env \
  "${auth_mount_args[@]}" \
  --proc /proc --dev /dev --tmpfs /tmp --chdir "/workspace${requested#"$root"}" \
  -- /bin/bash -c 'while IFS= read -r -d "" pair; do export "$pair"; done < /run/box-team-env; exec "$@"' \
  box-team-env "$runtime_bin" "$@"
